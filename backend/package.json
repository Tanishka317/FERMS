{
  "name": "ferms-backend",
  "version": "1.0.0",
  "description": "Fire Emergency Response Management System - Backend API",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
