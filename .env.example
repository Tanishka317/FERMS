# FERMS Frontend Environment Configuration

# Backend API endpoint URL (defaults to http://localhost:5000/api if omitted)
VITE_API_URL="http://localhost:5000/api"

# Google Maps JavaScript API Key (requires Maps JavaScript API enabled in Google Cloud Console)
# Provide your key in .env or .env.local — NEVER commit actual keys to version control.
VITE_GOOGLE_MAPS_API_KEY=""
